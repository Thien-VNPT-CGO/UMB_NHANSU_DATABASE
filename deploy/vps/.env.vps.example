# ENV mau cho ban VPS (nhanh vps) — du lieu HOAN TOAN RIENG ban cloud.
# Copy thanh apps/backend/.env tren VPS roi dien gia tri that:
#   cp deploy/vps/.env.vps.example apps/backend/.env

# --- Server ---
PORT=4005
NODE_ENV=production

# --- Auth (SINH MOI, khong dung chung ban cloud) ---
# openssl rand -hex 32
JWT_SECRET=thay-bang-chuoi-ngau-nhien-64-ky-tu
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# --- CORS: 1 domain DuckDNS duy nhat (https) ---
CORS_ORIGINS=https://umbomilk-nhansu-diemdanh.duckdns.org

# --- Google Sheets RIENG cho VPS (tao Spreadsheet moi, share Editor cho Service Account) ---
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
SPREADSHEET_ID=1UO1UF1d7_YzaCltYt2m9pRnUauGWw873ERqAMxwL-6k
CANDIDATE_SPREADSHEET_ID=1rvKfOzXgdALmNgyTl3R-5jigVhuJ0nw-s2jl6_kEqdg
GOOGLE_DRIVE_FOLDER_ID=15eQ7vLbnhwt5YVrnsOaKi-1jfAENesxR

# --- Tuan luong / realtime (giong ban cloud neu muon) ---
# 5000ms: toi da ~5s sau khi sua Sheet la web nhan duoc (neu KHONG cai webhook).
SHEETS_SYNC_INTERVAL_MS=5000
# Realtime 1-2s khi sua tay tren Sheet: secret PHAI TRUNG voi WEBHOOK_SECRET
# trong Google Apps Script (apps/backend/sheets-webhook.gs).
# Sinh secret: openssl rand -hex 32
SHEETS_WEBHOOK_SECRET=thay-bang-secret-ngau-nhien

# --- Chống dò PIN/mật khẩu ---
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Cảnh báo vận hành (tùy chọn; để trống = chỉ ghi log) ---
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_COOLDOWN_MINUTES=30

# --- Tai khoan admin khoi tao (khi ADMIN_ACCOUNTS tren Sheets moi con trong) ---
ADMIN_SEED_PASSWORD=Nguyenthanhthien@9999
