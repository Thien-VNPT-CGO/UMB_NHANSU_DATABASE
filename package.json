{
  "name": "umbo-milk-hr-system",
  "version": "1.0.0",
  "description": "Ụm Bò Milk HR System V5.1 - Realtime, Google Sheets Master, Admin & Employee Web Apps",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@ubm/shared",
    "build:backend": "npm run build --workspace=@ubm/backend",
    "build:admin": "npm run build --workspace=@ubm/admin-web",
    "build:employee": "npm run build --workspace=@ubm/employee-web",
    "build": "npm run build:shared && npm run build:backend && npm run build:admin && npm run build:employee",
    "start": "node apps/backend/dist/server.js",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "dev:employee": "npm run dev --workspace=apps/employee-web"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["hr", "sheets-master", "realtime", "socket.io", "react"],
  "author": "Ụm Bò Milk",
  "license": "UNLICENSED"
}
