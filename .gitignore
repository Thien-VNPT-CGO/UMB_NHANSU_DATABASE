# Build outputs
dist/
build/
*.tsbuildinfo
# packages/shared/dist + dist-esm la SAN PHAM BUILD (Docker/CI tu build tu src).
# Truoc day chung duoc commit khien moi lan `npm run build:shared` tren VPS lam
# cay git "dirty" -> `git pull --ff-only` fail -> autodeploy ket o commit cu.
packages/shared/dist/
packages/shared/dist-esm/

# Environment variables & secrets
.env
.env.local
.env.*.local
service-account*.json
credentials*.json
key.json
*.key.json
*.pem
# Zalo personal session (cookies HR) — KHÔNG BAO GIỜ commit
.zalo-session.json
apps/backend/.zalo-session.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
