*.swp
*.swo

# Temporary directories
.tempmediaStorage/
temp/
tmp/

# Anh check-in/out luu dia (fallback khong mat khi restart) — KHONG commit anh test
apps/backend/data/
# Snapshot/journal runtime khi chay backend tu thu muc goc (Docker/local)
/data/

# App version bake luc build (tu sinh, khong commit)
