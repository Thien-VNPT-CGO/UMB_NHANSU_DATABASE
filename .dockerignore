# Docker build context — loại trừ để image nhẹ + không lộ secret.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build output (được build lại trong image)
dist/
build/
*.tsbuildinfo

# Git & CI
.git/
.github/

# Secrets — KHÔNG BAO GIỜ đưa vào image
.env
.env.local
.env.*.local
service-account*.json
credentials*.json
*.pem

# Editor / OS / tạm
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.tempmediaStorage/
temp/
tmp/
coverage/

# Runtime data & persistent storage (mount runtime bằng volume, KHÔNG copy vào image)
data/
/data/
apps/backend/data/
*.tmp
*.tmp.*
*.bak
*.snapshot*
runtime-snapshot*

# Media, documents, archives & test files
docs/
deploy/
scripts/
*.jpg
*.jpeg
*.png
*.zip
*.tar.gz
*.xlsx
*.csv
.agents/
skills-lock.json

