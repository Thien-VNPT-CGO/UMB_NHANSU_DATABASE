# HaraSocial Zalo Alert — biến môi trường
# Copy file này thành .env trong apps/harasocial-monitor

NODE_ENV=development
PORT=3000
# Đặt 127.0.0.1 khi chạy sau Nginx trên VPS (chỉ proxy nội bộ mới vào được).
HOST=
# URL công khai khi deploy (dùng để tạo link webhook). Để trống = tự suy từ request.
PUBLIC_URL=

# PostgreSQL (bắt buộc)
DATABASE_URL=postgresql://ubm:matkhau@127.0.0.1:5432/harasocial
# set PGSSL=disable nếu PostgreSQL local không bật SSL
# PGSSL=disable

# Firebase Admin — xác thực ID token từ client
# Dán nguyên JSON service account (một dòng) hoặc base64 của file JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
# Hoặc dùng Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Firebase Web SDK (đăng nhập Google phía client)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# --- Xác thực dự phòng khi chưa bật Firebase ---
# Google OAuth Client ID (Web) dùng cho Google Identity Services.
GOOGLE_OAUTH_CLIENT_ID=
# Chỉ cho phép các email này đăng nhập (cách nhau bằng dấu phẩy). Để trống = mọi tài khoản Google.
HARA_ALLOWED_EMAILS=
# Mã truy cập quản trị + secret ký phiên (bắt buộc nếu không dùng Google/Firebase).
HARA_ACCESS_CODE=
HARA_SESSION_SECRET=
# Chủ sở hữu dữ liệu khi đăng nhập bằng mã truy cập.
HARA_OWNER_UID=ubm-director
HARA_OWNER_EMAIL=director@ubm.local
HARA_OWNER_NAME=Giám đốc UBM

# Chế độ dev không cần Firebase (chỉ NODE_ENV != production)
HARA_DEV_UID=
HARA_DEV_EMAIL=dev@localhost

# Cho phép gọi API nội bộ/http trong dev (SSRF guard vẫn bật ở production)
ALLOW_INSECURE_PULL=0

# Tắt worker SLA (mặc định bật)
HARA_WORKER_DISABLED=0
