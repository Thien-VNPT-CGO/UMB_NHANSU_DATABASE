# ===============================================================
# UBM HR SYSTEM V5.1 - BACKEND ENVIRONMENT VARIABLES
# ===============================================================
# SAO CHEP file nay thanh ".env" roi dien gia tri that vao.
# KHONG commit file .env vao git - chi commit file .env.example nay.
# ===============================================================

# --- Server ---
PORT=4005
NODE_ENV=development

# --- JWT Authentication ---
# BAT BUOC ở production (>=16 ký tự, nên >=32). Tao gia tri ngau nhien manh: openssl rand -hex 32
# Production thiếu JWT_SECRET: server vẫn boot nhưng sinh secret ngẫu nhiên tạm thời,
# mọi phiên đăng nhập hết hiệu lực sau mỗi lần restart — cấu hình ngay để tránh.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# TTL cho access token (mặc định 8h) và refresh token (mặc định 7d)
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# --- Seed admin (chỉ dùng lần đầu, đổi ngay sau khi đăng nhập) ---
ADMIN_SEED_PASSWORD=doi-ngay-sau-khi-dang-nhap!
# --- Seed HR mặc định umbomilk-hr (chỉ dùng lần đầu, đổi ngay sau khi đăng nhập) ---
HR_SEED_PASSWORD=doi-ngay-sau-khi-dang-nhap!

# --- CORS whitelist (HTTP + Socket.IO dùng chung) ---
# Production chạy cùng domain VPS nên không cần thêm; nếu web đặt server khác
# thì liệt kê domain, cách nhau bằng dấu phẩy (hỗ trợ wildcard dạng https://*.congty.vn).
# Request không có Origin (mobile/curl) luôn được cho qua.
# CORS_ORIGINS=https://web-congty.vn,https://*.congty.vn

# --- Rate limit (số request THẤT BẠI tối đa mỗi 15 phút; login thành công không tính) ---
AUTH_RATE_LIMIT_MAX=60
GENERAL_RATE_LIMIT_MAX=1000

# --- Khóa đăng nhập tạm thời khi nhập sai PIN/mật khẩu liên tiếp ---
# Áp dụng theo (tài khoản + IP) để tránh kẻ xấu cố tình khóa tài khoản người khác.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Cảnh báo vận hành (Google Sheets mock/stale, hàng đợi ghi kẹt, backup lỗi) ---
# Để trống = chỉ ghi log. Hỗ trợ webhook Slack/Discord/Google Chat.
# Telegram Bot API: dùng URL https://api.telegram.org/bot<TOKEN>/sendMessage
#   và đặt thêm ALERT_TELEGRAM_CHAT_ID=<chat_id>.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_COOLDOWN_MINUTES=30

# --- Cổng đăng ký 2 ngày OFF/tuần (giờ VN, mặc định UTC+7) ---
# Mở 09h00 Thứ 6 -> 09h00 Thứ 7, nhắc trước 5 phút, khóa chức năng khác đến khi đủ 2 ngày.
WEEKLY_OFF_TZ_OFFSET_HOURS=7
WEEKLY_OFF_REMINDER_MINUTES=5

# --- Zalo cá nhân HR (lib unofficial zca-js — có rủi ro bị Zalo khóa, nên dùng nick phụ) ---
# File session sau khi quét QR (KHÔNG commit). Khôi phục tự động sau restart.
# ZALO_SESSION_PATH=./apps/backend/.zalo-session.json
# Link Google Meet cố định đính kèm thư mời (nếu không truyền meetUrl từng lần).
# ZALO_DEFAULT_MEET_URL=https://meet.google.com/xxx-yyyy-zzz

# Địa chỉ công khai của Backend (để tạo link xác nhận PV cho ứng viên bấm,
# không cần đăng nhập). VD VPS: https://umbomilk-nhansu-diemdanh.duckdns.org/api
# PUBLIC_BASE_URL=https://umbomilk-nhansu-diemdanh.duckdns.org/api

# --- Google Service Account ---
# Cach 1 (khuyen nghi): Paste toan bo noi dung JSON cua Service Account key vao day
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cach 2 (thay the Cach 1):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# --- Google Sheets ---
# ID cua Google Spreadsheet MASTER duy nhat (lay tu URL: /spreadsheets/d/[ID]/edit)
SPREADSHEET_ID=1UO1UF1d7_YzaCltYt2m9pRnUauGWw873ERqAMxwL-6k

# ID cua Google Spreadsheet Form Ung vien
CANDIDATE_SPREADSHEET_ID=1rcqEKraSRhr-Tn9qwlhADlkQUei8j65bXeHF_Tmkd38

# --- Google Drive ---
# ID thu muc Drive de luu anh cham cong (de trong neu khong dung Drive)
GOOGLE_DRIVE_FOLDER_ID=

# --- Nhịp đồng bộ Sheets nền (ms, mặc định 5000) ---
# 5000 = tối đa ~5s sau khi sửa Sheet là web nhận được (khi chưa cài webhook).
# SHEETS_SYNC_INTERVAL_MS=5000

# --- Nhịp đọc các tab NHẬT KÝ phình to (ms, mặc định 120000) ---
# THONGBAO_NV/THONGBAO_GUI/SNAPSHOT_SAOLUU chiếm ~80% số ô. Đọc mỗi 5s làm pull
# chậm, block CPU và giành quota với thao tác thật. 120s là đủ realtime cho hộp thư.
# SHEETS_HISTORY_PULL_MS=120000

# --- Thời gian tối đa chờ push tab khi DUYỆT phiếu (ms, mặc định 3000) ---
# Duyệt xong là bộ nhớ + snapshot đã cập nhật; quá thời gian này push tiếp tục nền.
# SHEETS_APPROVAL_PUSH_WAIT_MS=3000

# --- Log các request chậm để chẩn đoán VPS (ms, mặc định 2000; 0 = tắt) ---
# Chỉ log method + route + status + thời gian, không log body (tránh lộ dữ liệu).
# SLOW_REQUEST_LOG_MS=2000

# --- Ngưỡng dọn conditional-format rules trùng (mặc định 600) ---
# Beautify từng add rule mỗi ngày mà không xoá rules cũ khiến tab phình hàng chục
# nghìn rule, Google Sheets ghi chậm 5-6s/lần. Vượt ngưỡng sẽ tự dọn trước khi add.
# SHEETS_CF_MAX_RULES=600

# --- Push ngược toàn bộ tabs lên Sheets định kỳ (phút, mặc định 60) ---
# Chỉ chạy khi bộ nhớ có thay đổi chưa lên Sheet (cờ dirty), không ghi lặp vô ích
# khi hệ thống nhàn rỗi. Tab nào thiếu trên Sheet sẽ được tự tạo lại (tạo tab +
# hàng header cột) rồi push đầy đủ dữ liệu. Đặt 0 để tắt.
# SHEETS_AUTO_PUSH_MINUTES=60

# --- Tự động căn chỉnh & làm đẹp giao diện Sheets (mặc định BẬT, 1 lần/ngày) ---
# Mỗi lần tốn ~20-30 write + đọc 20 dòng mỗi tab, lấn quota write của thao tác
# thật (check-in, duyệt phiếu). Định dạng thủ công ở cổng quản trị luôn hoạt động.
# SHEETS_AUTO_BEAUTIFY=1

# --- Webhook Apps Script onEdit (Sheet -> web 1-2s, xem sheets-webhook.gs) ---
# Secret dùng chung giữa Apps Script (header x-webhook-secret) và server.
# Tạo giá trị mạnh: openssl rand -hex 32. Thiếu là webhook luôn 403.
# SHEETS_WEBHOOK_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Cửa sổ gom sự kiện onEdit (ms). Mặc định 1000: sửa liên tục vẫn pull bù lượt cuối,
# nhưng mỗi lần sửa xong web nhận trong ~1-2s (pull đúng tab, không đọc 24 tab).
# SHEETS_WEBHOOK_COALESCE_MS=1000

# --- Bền vững dữ liệu (P0): snapshot khởi động + journal ghi Sheets ---
# Snapshot giúp restart phục vụ ngay thay vì 0 nhân viên trong 1-2 phút.
# Journal append bảo đảm check-in/phiếu/thông báo không mất khi Google timeout.
# Đường dẫn tương đối tính theo cwd backend; Docker mặc định /app/data (đã mount).
# RUNTIME_SNAPSHOT_FILE=./data/runtime-snapshot.json
# PENDING_WRITES_FILE=./data/pending-writes.json
# SINGLE_WRITER_JOURNAL_FILE=./data/single-writer-journal.json
# Số lần thử tối đa cho mỗi append trước khi vào dead-letter (mặc định 12).
# DURABLE_WRITE_MAX_ATTEMPTS=12
# Trần số bản ghi giữ lại trong dead-letter (mặc định 5000). Chỉ cần nâng khi
# Google chặn ghi kéo dài nhiều giờ; bản ghi vượt trần sẽ bị bỏ (cũ nhất trước).
# DURABLE_DEAD_LETTER_MAX=5000
# Gộp nhiều bản ghi CÙNG TAB vào 1 request Google (mặc định 100 bản ghi / 500 dòng).
# Không gộp thì mỗi bản ghi = 1 request → vượt quota 60 write/phút, hàng đợi kẹt.
# DURABLE_APPEND_BATCH_ENTRIES=100
# DURABLE_APPEND_BATCH_ROWS=500
# Chống bão lỗi: sau N lần gọi Google lỗi liên tiếp thì tạm nghỉ (mặc định 3 lần / 60s).
# DURABLE_WRITE_FAILURE_STREAK=3
# DURABLE_WRITE_PAUSE_MS=60000
# Khi tồn đọng > ngưỡng này, tab THONGBAO_* xếp sau dữ liệu nghiệp vụ (mặc định 300).
# DURABLE_WRITE_PRIORITY_THRESHOLD=300
# Tab lỗi liên tiếp bị hoãn RIÊNG (mặc định 600000ms = 10 phút) để 1 tab hỏng
# không chặn điểm danh/phiếu ca của tab khác.
# DURABLE_TAB_BACKOFF_MS=600000
# Khoảng cách tối thiểu giữa 2 lượt full-sync (mặc định 180000ms).
# Tab nóng (ca/nghỉ phép/đổi ca) đã push riêng ngay; full-sync chỉ là lưới an toàn.
# SHEETS_FULL_SYNC_MIN_INTERVAL_MS=180000
# Timeout cho 1 lần append (mặc định 30s; ghi lô lớn cần lâu hơn 20s cũ).
# SHEETS_APPEND_TIMEOUT_MS=30000
# Timeout HTTP thật tới Google (mặc định 25s): huỷ socket để request ghi không
# "treo" giữ khoá spreadsheet. Nên <= SHEETS_APPEND_TIMEOUT_MS.
# SHEETS_HTTP_TIMEOUT_MS=25000
