# ===============================================================
# UBM HR SYSTEM V5.1 - BACKEND ENVIRONMENT VARIABLES
# ===============================================================
# SAO CHEP file nay thanh ".env" roi dien gia tri that vao.
# KHONG commit file .env vao git - chi commit file .env.example nay.
# ===============================================================

# --- Server ---
PORT=4005
NODE_ENV=development

# --- JWT Authentication ---
# BAT BUOC ở production (>=16 ký tự, nên >=32). Tao gia tri ngau nhien manh: openssl rand -hex 32
# Production thiếu JWT_SECRET: server vẫn boot nhưng sinh secret ngẫu nhiên tạm thời,
# mọi phiên đăng nhập hết hiệu lực sau mỗi lần restart — cấu hình ngay để tránh.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# TTL cho access token (mặc định 8h) và refresh token (mặc định 7d)
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# --- Seed admin (chỉ dùng lần đầu, đổi ngay sau khi đăng nhập) ---
ADMIN_SEED_PASSWORD=doi-ngay-sau-khi-dang-nhap!
# --- Seed HR mặc định umbomilk-hr (chỉ dùng lần đầu, đổi ngay sau khi đăng nhập) ---
HR_SEED_PASSWORD=doi-ngay-sau-khi-dang-nhap!

# --- CORS whitelist (HTTP + Socket.IO dùng chung) ---
# Production: BAT BUOC liệt kê domain frontend, cách nhau bằng dấu phẩy.
# Hỗ trợ wildcard subdomain dạng https://*.vercel.app
# Request không có Origin (mobile app/curl) luôn được cho qua.
CORS_ORIGINS=https://admin-ubm.vercel.app,https://employee-ubm.vercel.app

# --- Rate limit (số request THẤT BẠI tối đa mỗi 15 phút; login thành công không tính) ---
AUTH_RATE_LIMIT_MAX=60
GENERAL_RATE_LIMIT_MAX=1000

# --- Cổng đăng ký 2 ngày OFF/tuần (giờ VN, mặc định UTC+7) ---
# Mở 12h00 Thứ 6 -> 15h00 Thứ 7, nhắc trước 5 phút, khóa chức năng khác đến khi đủ 2 ngày.
WEEKLY_OFF_TZ_OFFSET_HOURS=7
WEEKLY_OFF_REMINDER_MINUTES=5

# --- Zalo cá nhân HR (lib unofficial zca-js — có rủi ro bị Zalo khóa, nên dùng nick phụ) ---
# File session sau khi quét QR (KHÔNG commit). Khôi phục tự động sau restart.
# ZALO_SESSION_PATH=./apps/backend/.zalo-session.json
# Link Google Meet cố định đính kèm thư mời (nếu không truyền meetUrl từng lần).
# ZALO_DEFAULT_MEET_URL=https://meet.google.com/xxx-yyyy-zzz

# --- Google Service Account ---
# Cach 1 (khuyen nghi): Paste toan bo noi dung JSON cua Service Account key vao day
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cach 2 (thay the Cach 1):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# --- Google Sheets ---
# ID cua Google Spreadsheet MASTER (lay tu URL: /spreadsheets/d/[ID]/edit)
SPREADSHEET_ID=17iXM0zc1m17aX9AZrFMjOkPRMy2_CwWfjTRZSUPQF2w

# ID cua Google Spreadsheet Form Ung vien
CANDIDATE_SPREADSHEET_ID=1rcqEKraSRhr-Tn9qwlhADlkQUei8j65bXeHF_Tmkd38

# --- Google Drive ---
# ID thu muc Drive de luu anh cham cong (de trong neu khong dung Drive)
GOOGLE_DRIVE_FOLDER_ID=

# --- Nhịp đồng bộ Sheets nền (ms, mặc định 10000) ---
# SHEETS_SYNC_INTERVAL_MS=10000
